GROQ_API_KEYS=your-groq-api-key-1,your-groq-api-key-2
GOOGLE_API_KEY=your-google-api-key
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=multi-agent-deep-rag

QDRANT_URL=https://your-qdrant-cloud-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=ank-pdf
QDRANT_VECTOR_NAME=dense

RAG_DATA_DIR=./data/rag-data/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_NUM_CTX=1024

FAST_UI_MODE=true
FAST_RAG_K=2
USE_LLM_FILTERS=false
AGENT_RECURSION_LIMIT=6

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INGEST_BATCH_SIZE=10
INGEST_SLEEP_SECONDS=0.0
MAX_INGEST_CHUNKS=0
INGEST_MAX_RETRIES=5

GROQ_MODEL_NAME=llama-3.1-8b-instant
GROQ_FAST_MODEL=llama-3.1-8b-instant

MAIN_CHECKPOINT_DB=data/deep_finance_researcher.db
DEEP_AGENT_CHECKPOINT_DB=data/deep_agent_finance_researcher.db
RESEARCH_OUTPUT_DIR=research_outputs
AGENT_QUERY=Do a detailed analysis of Amazon's financial performance in 2023 and 2024
DEEP_AGENT_QUERY=What was Amazon's revenue in Q1 2024?
AGENT_USER_ID=default_user
AGENT_THREAD_ID=finance_test_07
